{
  "name": "jewellery-erp",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:desktop": "npm run tauri:dev -w packages/desktop",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend && npm run build -w packages/desktop",
    "build:desktop": "npm run tauri:build -w packages/desktop",
    "build:desktop:windows": "npm run tauri:build:windows -w packages/desktop",
    "build:desktop:mac": "npm run tauri:build:mac -w packages/desktop",
    "build:desktop:linux": "npm run tauri:build:linux -w packages/desktop",
    "tauri:icon": "cd packages/desktop && npx tauri icon",
    "db:generate": "npm run db:generate -w packages/backend",
    "db:push": "npm run db:push -w packages/backend",
    "db:studio": "npm run db:studio -w packages/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  }
}