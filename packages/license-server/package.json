{
  "name": "@jewellery-erp/license-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud license/subscription server with admin API for the Jewellery ERP desktop app",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../../scripts/ensure-license-core.mjs --strict && node ../../scripts/prisma-generate.mjs --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "dev": "node ../../scripts/ensure-license-core.mjs --strict && node ../../scripts/prisma-generate.mjs --schema prisma/schema.prisma && ts-node-dev --respawn --transpile-only src/index.ts",
    "prestart": "node ../../scripts/ensure-license-core.mjs --check",
    "start": "node dist/index.js",
    "db:push": "node ../../scripts/prisma-generate.mjs --schema prisma/schema.prisma && prisma db push --skip-generate",
    "db:generate": "node ../../scripts/prisma-generate.mjs --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "seed:admin": "node ../../scripts/ensure-license-core.mjs --strict && node ../../scripts/prisma-generate.mjs --schema prisma/schema.prisma && ts-node --transpile-only src/scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js",
    "generate-keys": "node ../../scripts/generate-license-keys.mjs",
    "generate-keys:ts": "node ../../scripts/ensure-license-core.mjs --strict && ts-node --transpile-only src/scripts/generate-keys.ts"
  },
  "dependencies": {
    "@jewellery-erp/license-core": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
