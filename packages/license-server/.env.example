# Jewellery ERP — License Server configuration
# Copy to `.env` in this folder and edit:  cp .env.example .env
# The server loads this file automatically at startup (real environment
# variables take precedence). `.env` itself is gitignored — never commit it.
# Full guide: docs/DEPLOY-LICENSE-SERVER-VPS.md

NODE_ENV=production

# Bind address/port. Behind Nginx on the same VPS keep HOST=127.0.0.1 so
# port 4010 is NOT reachable from the internet — only Nginx talks to it.
HOST=127.0.0.1
PORT=4010

# REQUIRED in production: signs admin-panel login tokens.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret

# First-boot admin account. These are ONLY used the very first time the
# server starts (when the database has no admin yet) — set them BEFORE the
# first start. To reset later: npm run seed:admin:prod -w packages/license-server
ADMIN_EMAIL=admin@jewellery-erp.cloud
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=License Admin

# Where the SQLite database lives (created automatically on first start).
# Adjust if the repo is not at /var/www/jewellery-erp.
LICENSE_DATA_DIR=/var/www/jewellery-erp/packages/license-server/data

# Database (optional). Leave unset for SQLite inside LICENSE_DATA_DIR.
# PostgreSQL example (also switch `provider` in prisma/schema.prisma and set
# LICENSE_AUTO_DB_PUSH=1 for the first boot only) — see the VPS guide, appendix B.
#DATABASE_URL=postgresql://user:password@127.0.0.1:5432/jewellery_license
#LICENSE_AUTO_DB_PUSH=1

# Signing key (optional). Default: keys/license-private-key.pem created by
# `npm run license:generate-keys`. Only set this to keep the key elsewhere.
#LICENSE_PRIVATE_KEY_FILE=/var/www/jewellery-erp/packages/license-server/keys/license-private-key.pem

# Dashboard: subscriptions expiring within this many days are "expiring soon".
EXPIRING_SOON_DAYS=30
