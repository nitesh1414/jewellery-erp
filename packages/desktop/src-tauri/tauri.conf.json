{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shri Jewellers ERP",
  "version": "1.0.0",
  "identifier": "com.jewellery.erp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shri Jewellers ERP",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "copyright": "Copyright (c) 2026 Shri Jewellers",
    "shortDescription": "Jewellery ERP and POS",
    "longDescription": "Complete jewellery shop ERP with billing, inventory, gold rate management, GST reports, job work tracking and offline POS.",
    "publisher": "Jewellery ERP",
    "homepage": "https://jewellery-erp.example",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13.0",
      "exceptionDomain": "",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "release": "1",
        "epoch": 0
      }
    }
  }
}
